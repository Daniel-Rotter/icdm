<http://www.semanticweb.org/rotter/interoperable-communication-data-model> a owl:Ontology ;
    terms:creator "Daniel Rotter"@en ;
    terms:description "This ontology was created as part of the master thesis \"Design of an interoperable communication data model for higher-level control systems in energy management\"."@en ;
    terms:title "Interoperable Communication Data Model (ICDM)"@en ;
    owl:imports <https://saref.etsi.org/core/v4.1.1/>,
        <https://saref.etsi.org/saref4bldg/v2.1.1/>,
        <https://saref.etsi.org/saref4ener/v2.1.1/>,
        <https://saref.etsi.org/saref4grid/v2.1.1/> ;
    owl:sameAs <http://www.semanticweb.org/rotter/interoperable-communication-data-model> ;
    owl:versionInfo "1.1" .

