dm:Closed a dm:OpenClosedState,
        owl:NamedIndividual,
        owl:Thing,
        saref:State ;
    owl:differentFrom dm:Open ;
    owl:sameAs dm:Closed .

dm:Faulty a dm:OperationalState,
        owl:NamedIndividual,
        owl:Thing,
        saref:State ;
    owl:differentFrom dm:Working ;
    owl:sameAs dm:Faulty .

dm:Level1_Unpredictable a dm:ControllabilityLevel,
        owl:NamedIndividual,
        owl:Thing ;
    owl:sameAs dm:Level1_Unpredictable .

dm:Occupied a dm:OccupancyState,
        owl:NamedIndividual,
        owl:Thing,
        saref:State ;
    owl:differentFrom dm:Unoccupied ;
    owl:sameAs dm:Occupied .

dm:Open a dm:OpenClosedState,
        owl:NamedIndividual,
        owl:Thing,
        saref:State ;
    owl:sameAs dm:Open .

dm:Unoccupied a dm:OccupancyState,
        owl:NamedIndividual,
        owl:Thing,
        saref:State ;
    owl:sameAs dm:Unoccupied .

